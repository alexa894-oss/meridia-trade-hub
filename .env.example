# Copia este archivo a .env.local y completa los valores del proyecto de Supabase de desarrollo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL de la app (enlaces del script de administrador). Ej.: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Solo servidor/scripts (nunca con prefijo NEXT_PUBLIC_): crear administrador y datos de prueba.
SUPABASE_SERVICE_ROLE_KEY=

# development | production. Con "production", npm run seed se niega a correr.
MERIDIA_ENV=development
